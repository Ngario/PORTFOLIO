# =============================================================================
# .env.example - Copy to .env and fill in for local development
# On Render: set these in Dashboard → Environment (do not commit .env)
# =============================================================================

# -----------------------------------------------------------------------------
# Environment: development | testing | production
# -----------------------------------------------------------------------------
CI_ENVIRONMENT = development

# -----------------------------------------------------------------------------
# App (required on Render)
# -----------------------------------------------------------------------------
# Your site URL with trailing slash. On Render use your Render URL.
# app.baseURL = https://your-app-name.onrender.com/
app.baseURL = http://localhost/portfolio/

# -----------------------------------------------------------------------------
# Database (optional locally; required on Render if you use MySQL)
# -----------------------------------------------------------------------------
# database.default.hostname = localhost
# database.default.username = root
# database.default.password =
# database.default.database = portfolio_db
# database.default.port = 3306

# -----------------------------------------------------------------------------
# Encryption (required if you use sessions/encryption in production)
# -----------------------------------------------------------------------------
# Generate with: php spark key:generate --show
# encryption.key = YOUR_32_CHAR_HEX_KEY

# -----------------------------------------------------------------------------
# Contact email (required for contact form delivery)
# -----------------------------------------------------------------------------
# contact.toEmail = your-inbox@example.com
# email.fromEmail = your-smtp-from@example.com
# email.fromName = Portfolio Website
# email.protocol = smtp
# email.SMTPHost = smtp.example.com
# email.SMTPUser = your-smtp-username
# email.SMTPPass = your-smtp-password
# email.SMTPPort = 587
# email.SMTPCrypto = tls
